# ---- App ----
APP_ENV=local
SOKQA_AUTHOR=Sokqa Team
PUBLIC_BASE_URL=http://localhost:8000/generated

# ---- Storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=generated
GCS_BUCKET=your-bucket-name
GCS_PREFIX=sokqa

# ---- TTS ----
TTS_RULES_PATH=tts_rules.json
TTS_USER_RULES_PATH=tts_user_rules.json
TTS_READING_MODE=rule
TTS_CREDIT_PER_CHAR=0.0001
CLOUD_TTS_LANGUAGE_CODE=ja-JP
CLOUD_TTS_VOICE=ja-JP-Neural2-B
CLOUD_TTS_SPEAKING_RATE=1.0
CLOUD_TTS_PITCH=0.0
CLOUD_TTS_MAX_CONCURRENCY=5
CLOUD_TTS_RECORDING_REQUEST_MAX_UNITS=20

# ---- Manifest / Domains ----
# カンマ区切りで許可ドメインを指定。実ドメインはコミットせずデプロイ環境で設定する。
ALLOWED_MANIFEST_DOMAINS=example.com,localhost,127.0.0.1

# ---- Creator ----
DEFAULT_CREATOR_ID=creator_default

# ---- Gemini / Model ----
GEMINI_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_DOC=gemini-2.5-flash
GEMINI_MODEL_QUIZ=gemini-2.5-flash
GEMINI_MODEL_PLANNER=gemini-2.5-flash
GEMINI_MODEL_QUALITY=gemini-2.5-flash
GEMINI_MODEL_FIX=gemini-2.5-flash

# ---- Google Cloud ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=false

# ---- Debug ----
# プロンプト全文をログ出力する調査用フラグ。本番では必ず false のままにする。
DEBUG_PROMPTS_ENABLED=false
